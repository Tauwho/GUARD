# GUARD start order (B-9, #43): sim -> gate -> supervisor -> planner -> bridge.
# Each process starts as root, attaches its path, sets its own SCHED_FIFO priority and drops to
# its uid (docs/architecture.md REF-PRIORITIES). A process whose binary is not in the image yet
# is skipped. Logs go to slog2 and /data/var/log/guard-start.log.
mkdir -p /data/var/log
echo "guard start $(date)" > /data/var/log/guard-start.log
# Normalized inputs (#141): the packed files must match inputs.json before GUARD starts.
[ -x /system/bin/guard-inputs-check ] && guard-inputs-check | tail -1 | sed "s/^/inputs: /" >> /data/var/log/guard-start.log
# secpol (#46): each process runs as its own type. /system/etc/guard-secpol names the mode.
T() { :; }
if [ -f /system/etc/guard-secpol ]; then
    T() { echo "-T $1"; }
    echo "secpol: $(cat /system/etc/guard-secpol)" >> /data/var/log/guard-start.log
fi
start() { # start <binary> <type> [waitfor path]
    [ -x /system/bin/$1 ] || { echo "skipped $1 (not in image)" >> /data/var/log/guard-start.log; return; }
    on -d $(T $2) /system/bin/$1
    [ -n "$3" ] && { waitfor $3 5 || echo "$1: $3 missing" >> /data/var/log/guard-start.log; }
    echo "started $1" >> /data/var/log/guard-start.log
}
if [ -x /system/bin/slm ] && [ -f /system/etc/guard-slm.xml ]; then
    # SLM image (#47): SLM starts the same order and restarts a process that dies.
    on -d slm /system/etc/guard-slm.xml
    waitfor /dev/name/local/guard/supervisor 10 || echo "slm: supervisor name missing" >> /data/var/log/guard-start.log
    echo "started by slm: guard-sim guard-gate guard-supervisor guard-planner guard-bridge" >> /data/var/log/guard-start.log
else
    start guard-sim sim_t /dev/sim/motor
    start guard-gate gate_t /dev/guard/gate
    start guard-supervisor supervisor_t /dev/name/local/guard/supervisor
    start guard-planner planner_t
    start guard-bridge bridge_t
fi